-        .source = .{ .includes = .{ .files = &.{
+    const posix_c_files: []const translate_c.Options.IncludeFile = switch (target.result.os.tag) {
+        // MinGW has no pwd.h. Password database lookups are
+        // never used on Windows (see os/passwd.zig).
+        .windows => &.{
             .{ .path = "errno.h" },
+            .{ .path = "signal.h" },
+            .{ .path = "sys/types.h" },
+            .{ .path = "unistd.h" },
+        },
+        else => &.{
+            .{ .path = "errno.h" },
             .{ .path = "pwd.h" },
             .{ .path = "signal.h" },
             .{ .path = "sys/types.h" },
             .{ .path = "unistd.h" },
-        } } },
+        },
+    };
+    try translate_c.addImportToModule(b, "posix_c", step.root_module, .{
+        .source = .{ .includes = .{ .files = posix_c_files } },
         .target = target,
         .optimize = optimize,
     });
