+    // GdkD3D12TextureBuilder is Windows-only, so the bindings lack it.
+    // It's a plain GObject, which is all we need.
+    const D3D12TextureBuilder = gobject.Object;
+    extern fn gdk_d3d12_texture_builder_new() *D3D12TextureBuilder;
+    extern fn gdk_d3d12_texture_builder_set_resource(self: *D3D12TextureBuilder, resource: *anyopaque) void;
+    extern fn gdk_d3d12_texture_builder_set_premultiplied(self: *D3D12TextureBuilder, premultiplied: c_int) void;
+    extern fn gdk_d3d12_texture_builder_build(
+        self: *D3D12TextureBuilder,
+        destroy: ?*const fn (?*anyopaque) callconv(.c) void,
+        data: ?*anyopaque,
+        err: *?*glib.Error,
+    ) ?*gdk.Texture;
+
+    /// Build a `GdkD3D12Texture` from the present and set it as our
+    /// current texture, unrefing any previous texture.
+    fn rebuildD3d12Texture(self: *Self, resource: *anyopaque) !void {
+        const priv = self.private();
+
+        const builder = gdk_d3d12_texture_builder_new();
+        defer builder.unref();
+        gdk_d3d12_texture_builder_set_resource(builder, resource);
+        gdk_d3d12_texture_builder_set_premultiplied(builder, 1);
+
+        var err_: ?*glib.Error = null;
+        const texture = gdk_d3d12_texture_builder_build(builder, null, null, &err_) orelse {
+            if (err_) |err| {
+                defer err.free();
+                log.warn("failed to build d3d12 texture err={s}", .{err.f_message orelse "(unknown)"});
+            }
+            return error.D3d12BuildFailed;
+        };
+
+        // Swap out the old texture.
+        if (priv.texture) |old| old.as(gobject.Object).unref();
+        priv.texture = texture;
     }
 
