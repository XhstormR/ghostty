+/// Close an end of the pipe from `internal_os.pipe()`. On Windows these
+/// are HANDLEs, which libc close would treat as a CRT fd and reject.
+fn closePipe(fd: posix.fd_t) void {
+    if (comptime builtin.target.os.tag == .windows) {
+        // Fixes for Windows: read thread quit pipe HANDLEs were leaked
+        _ = windows.exp.kernel32.CloseHandle(fd);
+    } else {
+        _ = posix.system.close(fd);
+    }
+}
